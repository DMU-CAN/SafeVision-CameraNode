CAMERA_SOURCE=usb
CAMERA_DEVICE=/dev/video0
WIDTH=1280
HEIGHT=720
FRAMERATE=30
BITRATE=2M
RTSP_PORT=8554
RTSP_PATH=cam

# Uncomment to push directly to a remote MediaMTX (e.g. the main backend's,
# see SafeVision-Backend README §7.1) instead of running a local RTSP server
# on this node — use this when this node's inbound firewall/NAT can't be
# opened to the backend. Only outbound to PUBLISH_HOST is then required.
# PUBLISH_HOST=<backend-ip>:8554
# PUBLISH_USER=publisher
# PUBLISH_PASS=<password from the backend's mediamtx.yml>
